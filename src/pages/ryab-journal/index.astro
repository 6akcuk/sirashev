---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentPage from '../../components/ContentPage.astro';
import PageHeader from '../../components/PageHeader.astro';
import { identity } from '../../site/consts/identity';
const posts = (await getCollection('ryabJournal')).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const date = (value: Date) => new Intl.DateTimeFormat('en', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(value);
---
<BaseLayout title={`Ryab Development Journal — ${identity.name}`} description="The development journal of Ryab: rebuilding a city events map with a new architecture.">
  <ContentPage maxWidth="1120px">
    <PageHeader heading="Ryab Development Journal"><p class="intro">Building a city events map from scratch: architecture, product decisions, experiments, and lessons along the way.</p></PageHeader>
    <section class="ryab-journal-intro" aria-label="About Ryab">
      <div><span class="eyebrow">PERSONAL PROJECT / REBUILDING FROM SCRATCH</span><p>Ryab is a personal project for discovering what is happening nearby. A new version is being built from scratch with a new architecture.</p><div class="case-links"><a class="text-link" href="/projects/ryab/">About the project →</a></div></div>
      <figure class="journal-preview"><img src="/images/ryab/overview.webp" alt="Earlier Ryab design concepts showing day and night map views" width="1440" height="1160" /><figcaption>Earlier design concepts with sample data; not a preview of the new version.</figcaption></figure>
    </section>
    <section aria-label="Journal entries"><div class="section-heading"><h2>Entries</h2><span class="eyebrow">{posts.length}</span></div><div class="writing-list">{posts.map(({id,data}) => <article><div class="eyebrow"><time datetime={data.publishedAt.toISOString()}>{date(data.publishedAt)}</time></div><h3><a href={`/ryab-journal/${id}/`}>{data.title}</a></h3><p>{data.description}</p></article>)}</div></section>
    <section class="note"><h2>More on Telegram</h2><p>Short updates and work in progress in my Russian-language channel.</p><a class="text-link" href="https://t.me/fromcode2product">From Code to Product ↗</a></section>
  </ContentPage>
</BaseLayout>
