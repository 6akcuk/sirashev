---
import { getCollection } from 'astro:content';
import ContentPage from '../components/ContentPage.astro';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { identity } from '../site/consts/identity';
const jobs = (await getCollection('jobs')).sort((a,b) => b.data.order.localeCompare(a.data.order));
---
<BaseLayout title={`Experience — ${identity.name}`} description="12+ years of commercial frontend and fullstack development, with experience at Linked Helper, Yandex Market, Playtomic and international client contracts.">
  <ContentPage maxWidth="1120px">
    <PageHeader heading="Experience"><p class="intro">12+ years of frontend and fullstack work. Desktop products, marketplaces, sports platforms and independent delivery for international clients.</p><a class="text-link" href="/Denis-Sirashev-Resume.pdf" download>Download full résumé ↓</a></PageHeader>
    <div class="timeline">{jobs.map(({data:j}) => <section class="job"><div class="mono">{j.period}</div><div><h2>{j.title}</h2><p class="job-company">{j.company} <span>· {j.location}</span></p><ul>{j.bullets.map(b => <li>{b}</li>)}</ul></div></section>)}</div>
    <section class="education"><h2 class="section-label">Education & languages</h2><p><strong>Ufa State Aviation Technical University</strong><br />Industrial Electronics · Engineer qualification · 2010</p><p>English — B2 · Russian — native</p></section>
  </ContentPage>
</BaseLayout>
