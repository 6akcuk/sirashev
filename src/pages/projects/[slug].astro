---
import { getCollection, type CollectionEntry } from 'astro:content';
import ContentPage from '../../components/ContentPage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { identity } from '../../site/consts/identity';
export async function getStaticPaths() {
  const cases = await getCollection('cases', ({ data }) => data.published);
  return cases.map(project => ({ params: { slug: project.id }, props: { project } }));
}
type Props = { project: CollectionEntry<'cases'> };
const { project: { data: p } } = Astro.props;
---
<BaseLayout title={`${p.title} — ${identity.name}`} description={p.summary}>
  <ContentPage maxWidth="1120px">
    <a class="back-link" href="/projects">← All projects</a>
    <header class="case-header"><span class="eyebrow">{p.num} / {p.company} / {p.year}</span><h1>{p.title}</h1><p class="intro">{p.description}</p><span class="case-status">{p.status}</span>
      {p.links.length > 0 && <div class="case-links">{p.links.map(link => <a class="text-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div>}
    </header>
    {p.images.length > 0 && <div class="case-gallery">{p.images.map((image, index) => <figure class:list={{ portrait: image.height > image.width && !image.src.endsWith('.svg') }}><a href={image.src} target="_blank" rel="noopener" aria-label={`View full-size: ${image.alt}`}><img src={image.src} alt={image.alt} width={image.width} height={image.height} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" /></a><figcaption>{image.caption}</figcaption></figure>)}</div>}
    {p.diagram && <div class="system-diagram" role="img" aria-label={`Conceptual overview: ${p.diagram.join(' → ')}`}><span class="diagram-label">System overview / conceptual</span><div>{p.diagram.map((step,i) => <><span class="diagram-node">{step}</span>{i < 2 && <span class="diagram-arrow" aria-hidden="true">→</span>}</>)}</div></div>}
    <div class="case-meta"><div><span>Role</span><strong>{p.role}</strong></div><div><span>Company / product</span><strong>{p.company}</strong></div><div><span>Stack</span><strong>{p.stack.join(' · ')}</strong></div></div>
    <article class="case-body">{p.sections.map(section => <section><h2>{section.heading}</h2><p>{section.body}</p></section>)}</article>
    <div class="case-footer"><a href="/projects">← More work</a><a href={`mailto:${identity.email}`}>Discuss this work ↗</a></div>
  </ContentPage>
</BaseLayout>
