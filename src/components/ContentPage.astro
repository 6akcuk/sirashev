---
type Props = { maxWidth?: string };

const { maxWidth } = Astro.props;
---

<div class="page" style={maxWidth ? `max-width:${maxWidth}` : undefined}>
  <slot />
</div>

<style>
  .page {
    padding: 56px 64px 72px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  @media (max-width: 760px) {
    .page {
      padding: 32px 20px 56px;
      gap: 44px;
    }
  }
</style>
