---
import { identity } from '../site/consts/identity';
---

<a class="contact" href={`mailto:${identity.email}`}>Get in touch</a>

<style>
  .contact {
    text-decoration: none;
    background: var(--accent);
    color: var(--accent-ink);
    padding: 13px 18px;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 600;
    text-align: center;
  }

  @media (max-width: 760px) {
    .contact {
      padding: 10px 14px;
      font-size: 14px;
    }
  }
</style>
