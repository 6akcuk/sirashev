---
type Props = { heading: string };

const { heading } = Astro.props;
---

<header class="page-header">
  <h1>{heading}</h1>
  <slot />
</header>

<style>
  .page-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  h1 {
    margin: 0;
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  @media (max-width: 760px) {
    h1 {
      font-size: 30px;
    }
  }
</style>
