---
import ContactButton from './ContactButton.astro';
import ExternalLinks from './ExternalLinks.astro';
import IdentityBlock from './IdentityBlock.astro';
import SiteNav from './SiteNav.astro';

type Props = { pathname: string };

const { pathname } = Astro.props;
---

<aside class="sidebar">
  <div class="sidebar-inner">
    <IdentityBlock />
    <SiteNav pathname={pathname} />
    <div class="foot">
      <ContactButton />
      <ExternalLinks />
    </div>
  </div>
</aside>

<style>
  .sidebar {
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: auto;
  }

  .sidebar-inner {
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    flex: 1;
    min-height: 0;
  }

  .foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* ≤760px: a static header rather than a sticky column. No burger menu. */
  @media (max-width: 760px) {
    .sidebar {
      position: static;
      height: auto;
      overflow: visible;
      border-right: none;
      border-bottom: 1px solid var(--line);
    }

    .sidebar-inner {
      padding: 20px;
      gap: 18px;
    }

    .foot {
      margin-top: 0;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px 16px;
    }
  }
</style>
